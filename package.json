{
  "name": "stackatlas",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramenta local e open-source para mapeamento e inventário de stacks",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "typecheck": "tsc --noEmit",
    "stackatlas": "node ./packages/core/bin/stackatlas.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.2",
    "typescript": "^5.4.5"
  }
}
